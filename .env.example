# Copy to .env (gitignored) and fill in. Never commit .env.

# Cheap 1x A10 prep/rehearsal host (us-west-1, steward-fs attached).
export LAMBDA_PREP=ubuntu@A10_IP

# Lambda hosts (us-west-1). Host A: prefill + gateway, k3s server. Host B: decode, k3s agent.
export LAMBDA_A=ubuntu@HOST_A_IP
export LAMBDA_B=ubuntu@HOST_B_IP
export LAMBDA_SSH_KEY=$HOME/.ssh/lambda_class7.pem

# Hugging Face token for model downloads
export HF_TOKEN=hf_xxxx
