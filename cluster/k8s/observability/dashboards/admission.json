    {
      "type": "timeseries",
      "title": "TTFT spread p99 - p50 (interactive vs batch)",
      "description": "p99_spread: where interactive is protected, its spread stays small while batch absorbs the wait.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, klass) (rate(orch_ttft_seconds_bucket[1m]))) - histogram_quantile(0.5, sum by (le, klass) (rate(orch_ttft_seconds_bucket[1m])))",
          "legendFormat": "{{klass}}",
          "refId": "A"
