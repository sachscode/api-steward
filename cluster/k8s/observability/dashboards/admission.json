    {
      "type": "timeseries",
      "title": "Client TTFT p50 / p99 by class",
      "description": "From gateway arrival: our queue + prefill + hop + first token. This is the SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, klass) (rate(orch_ttft_seconds_bucket[1m])))",
          "legendFormat": "p50 {{klass}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, klass) (rate(orch_ttft_seconds_bucket[1m])))",
          "legendFormat": "p99 {{klass}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
